[Unit]
Description=MemoryHub local memory service
Documentation=https://github.com/pyzw618/XA202612-2
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStartPre=/usr/lib/memoryhub/prepare-user
ExecStart=/opt/memoryhub/venv/bin/python -m uvicorn memoryhub.app:app --host 127.0.0.1 --port 8099
Restart=on-failure
RestartSec=3
UMask=0077
Environment=MEMORYHUB_CONFIG=/etc/memoryhub/config.yaml
Environment=MEMORYHUB_RUNTIME_MODE=development
Environment=MEMORYHUB_RUNTIME_ALLOW_FALLBACK=true
Environment=MEMORYHUB_EMBEDDING_PROVIDER=mock
Environment=MEMORYHUB_VECTOR_ENGINE_PROVIDER=faiss
Environment=MEMORYHUB_DB_PATH=%h/.local/share/MemoryHub/data/memoryhub.db

[Install]
WantedBy=default.target
