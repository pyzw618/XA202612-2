#!/bin/sh
set -eu

# Keep user preparation and the long-running server in one executable.  The
# underscore-only filename avoids KARE's command escaping bug for executable
# paths containing hyphens.
/usr/lib/memoryhub/prepare-user

# Prefer the user-writable config seeded by prepare-user: /etc/memoryhub is
# root-owned, so the service cannot persist settings changes from there.
# An explicit MEMORYHUB_CONFIG in the environment still wins.
if [ -z "${MEMORYHUB_CONFIG:-}" ] && [ -r "$HOME/.config/memoryhub/config.yaml" ]; then
    MEMORYHUB_CONFIG="$HOME/.config/memoryhub/config.yaml"
fi
: "${MEMORYHUB_CONFIG:=/etc/memoryhub/config.yaml}"
: "${MEMORYHUB_RUNTIME_MODE:=production}"
: "${MEMORYHUB_RUNTIME_ALLOW_FALLBACK:=false}"
: "${MEMORYHUB_EMBEDDING_PROVIDER:=kylin}"
: "${MEMORYHUB_VECTOR_ENGINE_PROVIDER:=milvus}"
: "${MEMORYHUB_VECTOR_ENGINE_APP_ID:=kylin-memoryhub}"
: "${MEMORYHUB_VECTOR_ENGINE_LOCAL_SOCKET:=true}"
: "${MEMORYHUB_DB_PATH:=$HOME/.local/share/MemoryHub/data/memoryhub.db}"
export MEMORYHUB_CONFIG MEMORYHUB_RUNTIME_MODE MEMORYHUB_RUNTIME_ALLOW_FALLBACK
export MEMORYHUB_EMBEDDING_PROVIDER MEMORYHUB_VECTOR_ENGINE_PROVIDER
export MEMORYHUB_VECTOR_ENGINE_APP_ID MEMORYHUB_VECTOR_ENGINE_LOCAL_SOCKET
export MEMORYHUB_DB_PATH

native_lib_dir=/usr/lib/memoryhub/native
if [ -d "$native_lib_dir" ]; then
    LD_LIBRARY_PATH="$native_lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
fi

exec /opt/memoryhub/venv/bin/python -m uvicorn memoryhub.app:app \
    --host 127.0.0.1 --port 8099
