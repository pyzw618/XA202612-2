{
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/claudecode-integration/plugin/memoryhub/scripts/record.py", "--accumulate"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/claudecode-integration/plugin/memoryhub/scripts/record.py", "--flush-turn"],
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/claudecode-integration/plugin/memoryhub/scripts/record.py", "--flush-all"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
