  "governance_ref": [
    {
      "source_id": "gbt-41817-2022",
      "role": "lifecycle",
      "locator": "个人信息安全工程生命周期",
      "derivation_note": "用于规则需求、设计、测试、发布、变更和退役治理。",
      "caveat": "该标准不直接生成任何单条检测正则或默认动作。"
