  "rules": [
    {
      "rule_id": "credential_field",
      "category": "credential",
      "risk_level": "high",
      "default_action": "reject",
      "pattern": "(?s)\\A(?!\\[REDACTED(?:_[A-Z0-9_]+)?\\]\\Z).+\\Z",
      "validator": "builtin.non_placeholder@1.0",
      "masker": "builtin.full_redact@1.0",
      "target_paths": [
        "/**/access_token",
        "/**/accessKey",
        "/**/accessToken",
        "/**/api-key",
        "/**/apiKey",
        "/**/api_key",
        "/**/authorization",
        "/**/clientSecret",
        "/**/client_secret",
        "/**/passwd",
        "/**/password",
        "/**/refreshToken",
        "/**/refresh_token",
        "/**/secret",
        "/**/secretAccessKey",
        "/**/secretKey",
        "/**/secret_key",
        "/**/token"
      ],
      "target_path_case_sensitive": false,
      "priority": 1000,
      "standard_ref": [
        {
          "source_id": "kmh-policy-1.0",
          "role": "risk_policy",
          "locator": "credential fields",
          "derivation_note": "端侧长期记忆不保存结构化凭据字段的原值。",
          "caveat": "字段名列表是项目策略，需随接入源和厂商格式版本更新。"
        },
        {
          "source_id": "owasp-secrets",
          "role": "threat_model",
          "locator": "secret identification and lifecycle",
          "derivation_note": "凭据材料独立于个人信息分类建模。",
          "caveat": "OWASP 是安全指南，不是国标或厂商格式合同。"
        }
      ],
      "rule_version": "1.0",
      "enabled": true,
      "reason_code": "secret.credential_field",
      "reason": "结构化凭据字段的值不得进入端侧长期记忆。",
      "replacement": "[REDACTED_CREDENTIAL]",
      "match_group": 0
    },
    {
      "rule_id": "credential.private_key",
      "category": "credential",
      "risk_level": "high",
      "default_action": "reject",
      "pattern": "(?s)(?P<value>-----BEGIN (?:RSA |EC |ENCRYPTED )?PRIVATE KEY-----.*?-----END (?:RSA |EC |ENCRYPTED )?PRIVATE KEY-----)",
      "validator": "builtin.pem_private_key@1.0",
      "masker": "builtin.full_redact@1.0",
      "target_paths": ["/**"],
      "priority": 980,
      "standard_ref": [
        {
          "source_id": "kmh-policy-1.0",
          "role": "risk_policy",
          "locator": "private key handling",
          "derivation_note": "检测到私钥封装时默认拒绝写入。",
          "caveat": "拒绝动作是项目策略，不是 RFC 7468 的规范要求。"
        },
        {
          "source_id": "rfc-7468",
          "role": "syntax",
          "locator": "sections 10-11",
          "derivation_note": "PEM 文本边界用于产生私钥候选。",
          "caveat": "候选检测不验证密钥材料的密码学正确性。"
        }
      ],
      "rule_version": "1.0",
      "enabled": true,
      "reason_code": "secret.private_key",
      "reason": "私钥材料不得进入端侧长期记忆。",
      "replacement": "[REDACTED_PRIVATE_KEY]",
      "match_group": "value"
    },
    {
      "rule_id": "credential.bearer_token",
      "category": "credential",
      "risk_level": "high",
      "default_action": "reject",
      "pattern": "(?i)\\bBearer\\s+(?P<value>[A-Za-z0-9\\-._~+/]+=*)",
      "validator": "builtin.non_placeholder@1.0",
      "masker": "builtin.full_redact@1.0",
      "target_paths": ["/**"],
      "priority": 960,
      "standard_ref": [
        {
          "source_id": "kmh-policy-1.0",
          "role": "risk_policy",
          "locator": "bearer credentials",
          "derivation_note": "Bearer 凭据在端侧记忆中默认拒绝。",
          "caveat": "风险动作由项目威胁模型决定。"
        },
        {
          "source_id": "rfc-6750",
          "role": "syntax",
          "locator": "section 2.1",
          "derivation_note": "Authorization Bearer 上下文用于降低通用 Token 误报。",
          "caveat": "正则只产生候选，不是完整 OAuth 协议验证。"
        }
      ],
      "rule_version": "1.0",
      "enabled": true,
      "reason_code": "secret.bearer_token",
      "reason": "Bearer Token 不得进入端侧长期记忆。",
      "replacement": "[REDACTED_BEARER_TOKEN]",
      "match_group": "value"
    },
    {
      "rule_id": "credential.jwt",
      "category": "credential",
      "risk_level": "high",
      "default_action": "reject",
      "pattern": "(?<![A-Za-z0-9_-])(?P<value>eyJ[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+)(?![A-Za-z0-9_-])",
      "validator": "builtin.jwt@1.0",
      "masker": "builtin.full_redact@1.0",
      "target_paths": ["/**"],
      "priority": 940,
      "standard_ref": [
        {
          "source_id": "kmh-policy-1.0",
          "role": "threat_model",
          "locator": "JWT in local memory",
          "derivation_note": "JWT 候选按可能承载 bearer 凭据处理。",
          "caveat": "JWT 不必然是秘密，后续策略层可按可信上下文覆盖。"
        },
        {
          "source_id": "rfc-7519",
          "role": "syntax",
          "locator": "section 3",
          "derivation_note": "三段 compact serialization 与 JSON 头/载荷用于语义校验。",
          "caveat": "校验器不验证签名，也不判定 Token 当前是否有效。"
        }
      ],
      "rule_version": "1.0",
      "enabled": true,
      "reason_code": "secret.jwt",
      "reason": "JWT 候选需要阻止进入端侧长期记忆。",
      "replacement": "[REDACTED_JWT]",
      "match_group": "value"
    },
    {
      "rule_id": "api_key",
      "category": "credential",
      "risk_level": "high",
      "default_action": "reject",
      "pattern": "(?i)(?:api[_-]?key|secret|password|token)\\s*[:=]\\s*(?P<value>(?!\\[REDACTED_[A-Z0-9_]+\\](?:\\s|$))\\S+)",
