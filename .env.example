# Kylin-MemoryHub 环境变量配置

# --- LLM 配置 ---
LLM_PROVIDER=openai
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2:1.5b

# --- Embedding 配置 ---
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1024

# --- 存储配置 ---
DB_PATH=data/memoryhub.db
VECTOR_INDEX_PATH=data/vector_index
EVIDENCE_PATH=data/evidence

# --- 检索配置 ---
RETRIEVAL_TOP_K=5
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.3
METADATA_WEIGHT=0.1

# --- 应用配置 ---
DEBUG=false
