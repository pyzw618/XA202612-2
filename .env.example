# Kylin-MemoryHub 环境变量配置

# --- LLM 配置 ---
LLM_PROVIDER=openai
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2:1.5b

# --- Embedding 配置 ---
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1024

# --- 存储配置 ---
DB_PATH=data/memoryhub.db
VECTOR_INDEX_PATH=data/vector_index
EVIDENCE_PATH=data/evidence

# --- 安全密钥（示例文件中不要填写真实值） ---
# 32 字节随机主密钥的 Base64 编码；与审计、REVIEW 隔离密钥相互独立。
MEMORYHUB_USER_RULE_KEY=

# --- 检索配置 ---
RETRIEVAL_TOP_K=5
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.3
METADATA_WEIGHT=0.1

# --- 应用配置 ---
DEBUG=false
