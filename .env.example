# Kylin-MemoryHub 环境变量示例
# 复制为 .env 并按需填写（服务启动时由 load_config() 自动加载；已存在的系统环境变量优先）。
# 只列出代码实际读取的变量；完整说明见 docs/configuration.md。
# 示例文件中不要填写任何真实密钥。

# ==================== 后端服务 ====================

# --- 运行模式 ---
# production | development | test（production 触发门禁校验，禁止 mock/faiss 降级）
MEMORYHUB_RUNTIME_MODE=development
MEMORYHUB_RUNTIME_ALLOW_FALLBACK=true

# --- vNext 链路切流 ---
# legacy | shadow | dual-read | canary | vnext
MEMORYHUB_VNEXT_MODE=vnext
# 仅 canary 模式允许 5/25/50/100；其他模式必须为 0
MEMORYHUB_VNEXT_CANARY_PERCENT=0

# --- 存储 ---
MEMORYHUB_DB_PATH=data/memoryhub.db

# --- LLM（OpenAI 兼容接口；LLM_* 为便携名，MEMORYHUB_LLM_* 为等价别名）---
# 注意：在这里设置 LLM_API_BASE / LLM_MODEL 会覆盖 config.yaml（优先级 进程env > .env > config.yaml），
# 使桌面端"LLM 服务配置"页面的保存对 api_base/model 失效。默认交由 config.yaml 与页面管理，
# 仅在需要临时覆盖时取消注释。
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-flash
# 密钥只放这里（.env 已被 .gitignore 忽略）；不要写进 config.yaml —— 该文件被 git 跟踪。
LLM_API_KEY=

# --- Embedding / 向量引擎 ---
# provider: mock | kylin_mock | kylin（生产）
MEMORYHUB_EMBEDDING_PROVIDER=mock
# provider: faiss | milvus_mock | milvus（生产）
MEMORYHUB_VECTOR_ENGINE_PROVIDER=faiss
# milvus / milvus_mock 必填，由部署平台提供；切勿提交真实值
MEMORYHUB_VECTOR_ENGINE_APP_ID=

# --- 安全密钥（可选：首次启动会自动生成并保存到 <db目录>/security/safety-keys.json）---
# 32 字节随机密钥的 Base64 编码，三把密钥相互独立
MEMORYHUB_AUDIT_HMAC_KEY=
MEMORYHUB_QUARANTINE_KEY=
MEMORYHUB_USER_RULE_KEY=

# --- 其他 ---
MEMORYHUB_DEBUG=false
# 指定非默认配置文件路径
# MEMORYHUB_CONFIG=config.yaml

# ==================== Agent 接入端（CLI / MCP / OpenCode 插件）====================

# 后端服务地址与用户标识
MEMORYHUB_API_URL=http://127.0.0.1:8099
MEMORYHUB_USER_ID=default
# 可选：MEMORYHUB_TENANT_ID / MEMORYHUB_TOP_K / MEMORYHUB_MIN_CONFIDENCE /
#       MEMORYHUB_SCENE / MEMORYHUB_TASK_TYPE / MEMORYHUB_PROJECT /
#       MEMORYHUB_API_TIMEOUT / MEMORYHUB_AUTO_RECORD
# 详见 agent-integration/README.md
