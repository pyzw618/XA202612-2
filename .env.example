# Kylin-MemoryHub 环境变量配置

# --- LLM 配置 ---
LLM_PROVIDER=openai
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2:1.5b

# --- Embedding 配置 ---
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1024

# --- 存储配置 ---
DB_PATH=data/memoryhub.db
VECTOR_INDEX_PATH=data/vector_index
EVIDENCE_PATH=data/evidence

# --- 安全密钥（示例文件中不要填写真实值） ---
# 32 字节随机主密钥的 Base64 编码；与审计、REVIEW 隔离密钥相互独立。
MEMORYHUB_USER_RULE_KEY=

# --- 检索配置 ---
RETRIEVAL_TOP_K=5
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.3
METADATA_WEIGHT=0.1

# --- Milvus vector engine (required for milvus/milvus_mock; never commit the real value) ---
MEMORYHUB_VECTOR_ENGINE_APP_ID=

# --- 应用配置 ---
DEBUG=false
MEMORYHUB_URL=http://127.0.0.1:8000

# --- 千问 Agent（阿里云百炼 OpenAI-compatible API）---
DASHSCOPE_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.1
