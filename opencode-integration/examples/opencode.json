{
  "$schema": "https://opencode.ai/config.json",
  // ------------------------------------------------------------------
  // MemoryHub MCP server
  // ------------------------------------------------------------------
  // Exposes MemoryHub's REST API to the LLM as tools (memoryhub_search,
  // memoryhub_write_event, memoryhub_forget, ...).
  //
  // Requirements:
  //   1. MemoryHub REST service must be running:
  //        python opencode-integration/scripts/start_memoryhub_server.py
  //   2. `python` below must resolve to a Python >= 3.10 that has httpx
  //      installed (the project's requirements.txt). On this dev machine:
  //        "D:/Anaconda/envs/py12/python.exe"
  //      On Kylin use the system python.
  //   3. `cwd` makes `python -m memoryhub_mcp` importable and lets the
  //      server locate the memoryhub repo for schema validation.
  "mcp": {
    "memoryhub": {
      "type": "local",
      "command": ["python", "-m", "memoryhub_mcp"],
      "cwd": "opencode-integration/mcp-server",
      "environment": {
        "MEMORYHUB_API_URL": "http://127.0.0.1:8010",
        "MEMORYHUB_USER_ID": "opencode",
        "MEMORYHUB_TOP_K": "5"
      },
      "enabled": true
    }
  },
  // ------------------------------------------------------------------
  // MemoryHub auto-record plugin
  // ------------------------------------------------------------------
  // The plugin cannot be configured here (no `env` key). Export these
  // variables in the shell before starting opencode, or set them in your
  // shell profile:
  //
  //   export MEMORYHUB_API_URL=http://127.0.0.1:8010
  //   export MEMORYHUB_USER_ID=opencode
  //   export MEMORYHUB_AUTO_RECORD=true
  //
  // Then install the plugin once:
  //   node opencode-integration/scripts/install_plugin.mjs
  // (copies opencode-integration/plugin/memoryhub.plugin.mjs into
  //  .opencode/plugins/ — opencode auto-loads it on the next start.)
  //
  // The plugin listens to `session.idle` and POSTs the session's assistant
  // text + tool calls to `POST /api/memory/events` for automatic
  // preference/knowledge/fact extraction.
  "tools": {
    // Optional: if you do not want the LLM to see the memory tools, disable
    // the whole MCP server here. Kept enabled by default.
  }
}
